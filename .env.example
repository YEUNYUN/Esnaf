# ============================================================================
# Esnaf — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All settings have sensible defaults for paper trading.
# Only API keys are required for the features you want to use.
# ============================================================================

# ── Exchange Configuration ──────────────────────────────────────────────────
# Binance API credentials for market data and (eventually) live trading.
# Get keys from: https://www.binance.com/en/my/settings/api-management
# For testnet keys: https://testnet.binance.vision/
BINANCE_API_KEY=your-binance-api-key-here
BINANCE_SECRET=your-binance-secret-here

# Use Binance testnet instead of production (default: true — KEEP THIS ON)
BINANCE_TESTNET=true

# ── LLM Configuration ──────────────────────────────────────────────────────
# Primary model: Claude Sonnet via Copilot proxy (deep reasoning for active markets)
# Requires copilot-api running locally: npx copilot-api
PRIMARY_MODEL=openai/claude-sonnet-4-20250514

# Cheap model: Gemini Flash for calm-market checks (preserves Copilot quota)
CHEAP_MODEL=gemini/gemini-2.5-flash

# Fallback model: local Ollama when APIs are unavailable
FALLBACK_MODEL=ollama/llama3.1

# Copilot API proxy base URL (started with: npx copilot-api)
COPILOT_API_BASE=http://localhost:4141/v1

# Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Volatility threshold below which the cheap model is used instead of primary
CALM_VOLATILITY_THRESHOLD=0.02

# LLM temperature (0 = deterministic, recommended for trading)
TEMPERATURE=0.0

# ── Risk Management ─────────────────────────────────────────────────────────
# These are HARD LIMITS enforced by deterministic code — the LLM cannot override them.

# Maximum capital the agent can manage (USD)
MAX_CAPITAL=10000.0

# Max single position size as % of capital
MAX_POSITION_PCT=10.0

# Max daily drawdown before all trading is paused (% of capital)
MAX_DAILY_DRAWDOWN_PCT=3.0

# Max total portfolio exposure (% of capital deployed at once)
MAX_TOTAL_EXPOSURE_PCT=30.0

# Minimum LLM confidence to allow a trade (0.0–1.0)
MIN_CONFIDENCE_THRESHOLD=0.7

# Minimum regime classification confidence (below this → sit out)
MIN_REGIME_CONFIDENCE=0.6

# Confidence required for counter-trend trades (e.g. buying in a bear regime)
COUNTER_TREND_CONFIDENCE=0.8

# Cooldown between trades on the same pair (minutes)
TRADE_COOLDOWN_MINUTES=30

# Maximum number of trades per day
MAX_TRADES_PER_DAY=10

# Stop-loss per position (%)
STOP_LOSS_PCT=3.0

# Kill switch: halt ALL trading if drawdown exceeds this (% of capital)
KILL_SWITCH_DRAWDOWN_PCT=5.0

# Exchange fee rate per trade (Binance default: 0.1%)
FEE_RATE=0.001

# ── Agent Configuration ─────────────────────────────────────────────────────
# Trading pair (must be available on your exchange)
TRADING_PAIR=BTC/USDT

# How often the agent runs a full analysis cycle (minutes)
CYCLE_INTERVAL=15

# Analysis interval — how often indicators are recomputed (minutes)
ANALYSIS_INTERVAL=15

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Paper trading mode (default: true — set to false ONLY after proving an edge)
PAPER_TRADING=true

# Starting capital for paper trading simulation (USD)
INITIAL_CAPITAL=10000.0

# ── Sentiment Data (Optional) ──────────────────────────────────────────────
# CryptoPanic news API: https://cryptopanic.com/developers/api/
# Provides crypto news headlines for sentiment scoring.
CRYPTOPANIC_API_KEY=your-cryptopanic-api-key-here
