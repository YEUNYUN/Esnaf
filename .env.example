# === Exchange API Keys ===
# Get from: https://www.binance.com/en/my/settings/api-management
# USE TESTNET KEYS FIRST: https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret
BINANCE_TESTNET=true

# === LLM Configuration ===
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Copilot API proxy runs on localhost:4141 (no key needed)
# Start with: npx copilot-api
COPILOT_API_BASE=http://localhost:4141/v1

# === Optional: Sentiment Data ===
# Reddit API: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# CryptoPanic: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# === Agent Configuration ===
# Trading pair
TRADING_PAIR=BTC/USDT

# Analysis interval in minutes
ANALYSIS_INTERVAL=15

# Risk limits
MAX_POSITION_PCT=10
MAX_DAILY_DRAWDOWN_PCT=3
MIN_CONFIDENCE_THRESHOLD=0.7

# Log level
LOG_LEVEL=INFO
